# Application Insights Connection String (OPTIONAL - Telemetry will be disabled if not provided)
# Get this from Azure Portal -> Your Web App -> Application Insights
# Format: InstrumentationKey=xxx;IngestionEndpoint=https://xxx.in.applicationinsights.azure.com/
# Leave empty if you don't want to use Application Insights monitoring
VITE_APPLICATIONINSIGHTS_CONNECTION_STRING=

# Google OAuth Configuration
# Get this from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Microsoft OAuth Configuration
# Get this from Azure Portal -> Microsoft Entra ID -> App registrations
# TenantId: Use 'common' for multi-tenant, or your specific tenant ID
# ClientId: Application (client) ID from your app registration
VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
VITE_MICROSOFT_TENANT_ID=common

# API Configuration (optional - defaults to /api)
# VITE_API_URL=https://mentalhealthjournal-webapp.azurewebsites.net/api
